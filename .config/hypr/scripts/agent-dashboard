#!/usr/bin/env bash
# agent-dashboard — Terminal TUI for viewing/managing Claude agents across projects.
#
# Three sections grouped by project: Working, Waiting for Input, Completed.
# Keyboard: j/k navigate, Enter attach, n new agent, s stop, m merge, r reject,
#           / filter, Esc/q quit.
#
# Launched via: alacritty --class=agent-dashboard -e agent-dashboard
#   or bound to: SUPER+SUPER_L → t → g

set -euo pipefail

DATA_SCRIPT="${HOME}/.config/hypr/scripts/agent-dashboard-data.sh"

# ── Constants ──────────────────────────────────────────────────────────────

C_RESET=$'\e[0m'
C_BOLD=$'\e[1m'
C_DIM=$'\e[2m'

# 256-color ANSI escapes (works in alacritty, kitty, etc).
c256() { printf '\033[38;5;%dm' "$1"; }

# Named colors via 256-color palette.
C_GREY=$(c256 245)
C_BLUE=$(c256 39)
C_MAGENTA=$(c256 140)
C_YELLOW=$(c256 221)
C_GREEN=$(c256 78)
C_RED=$(c256 203)
C_CYAN=$(c256 51)
C_WHITE=$(c256 255)
C_BRIGHT=$(c256 252)
C_DARK=$(c256 238)

# Section header colors.
C_WORKING="${C_YELLOW}"
C_WAITING="${C_BLUE}"
C_COMPLETED="${C_GREY}"

# Phase tag colors.
declare -A PHASE_COLOR=(
    [IMPLEMENTING]="${C_YELLOW}"
    [REVIEWING]="${C_GREEN}"
    [PLANNING]="${C_MAGENTA}"
    [RESEARCHING]="${C_BLUE}"
    [PENDING_REVIEW]="${C_GREEN}"
    [COMPLETED]="${C_GREY}"
    [FAILED]="${C_RED}"
    [MERGED]="${C_GREY}"
)

# ── State ──────────────────────────────────────────────────────────────────

DATA_JSON="[]"
SELECTED_INDEX=0
FILTER_TEXT=""
FILTER_ACTIVE=false
NEEDS_REFRESH=true
TOTAL_ROWS=0
TERM_ROWS=24
TERM_COLS=80
SAVED_STTY=""

# ── Terminal setup / teardown ──────────────────────────────────────────────

setup_terminal() {
    SAVED_STTY=$(stty -g 2>/dev/null || true)
    printf '\033[?1049h'   # alt screen
    printf '\033[?25l'     # hide cursor
    stty raw -echo 2>/dev/null || true
}

restore_terminal() {
    printf '\033[?25h'     # show cursor
    printf '\033[?1049l'   # restore screen
    if [[ -n "${SAVED_STTY:-}" ]]; then
        stty "${SAVED_STTY}" 2>/dev/null || true
    fi
}

trap restore_terminal EXIT

# ── Data loading ───────────────────────────────────────────────────────────

load_data() {
    DATA_JSON=$("${DATA_SCRIPT}" 2>/dev/null || echo "[]")
    NEEDS_REFRESH=false
}

get_visible_all() {
    local filter="${FILTER_TEXT,,}"
    if [[ -z "${filter}" ]]; then
        echo "${DATA_JSON}"
    else
        echo "${DATA_JSON}" | jq --arg f "${filter}" \
            '[.[] | select(
                (.taskSlug | ascii_downcase | contains($f)) or
                (.taskTitle | ascii_downcase | contains($f)) or
                (.projectSlug | ascii_downcase | contains($f))
            )]' 2>/dev/null || echo "[]"
    fi
}

get_visible_agent() {
    local idx="$1"
    local filter="${FILTER_TEXT,,}"
    if [[ -z "${filter}" ]]; then
        echo "${DATA_JSON}" | jq ".[${idx}] // empty" 2>/dev/null
    else
        echo "${DATA_JSON}" | jq --arg f "${filter}" \
            "[.[] | select(
                (.taskSlug | ascii_downcase | contains(\$f)) or
                (.taskTitle | ascii_downcase | contains(\$f)) or
                (.projectSlug | ascii_downcase | contains(\$f))
            )][${idx}] // empty" 2>/dev/null
    fi
}

recount() {
    local v
    v=$(get_visible_all)
    TOTAL_ROWS=$(echo "${v}" | jq 'length' 2>/dev/null || echo 0)
}

# ── Rendering helpers ──────────────────────────────────────────────────────

clear_screen() { printf '\033[2J\033[H'; }
goto() { printf '\033[%d;%dH' "$1" "$2"; }

pad() {
    local str="$1" width="$2"
    local plain="${str//$'\e'\[*([0-9;])m/}"
    plain="${plain//$'\e'*([^a-zA-Z])/}"
    if [[ ${#str} -gt ${width} ]]; then
        printf '%s' "${str:0:$((width))}"
    else
        local padlen=$(( width - ${#str} + (${#str} - ${#plain}) ))
        printf '%s%*s' "${str}" "${padlen}" ""
    fi
}

phase_color() {
    local p="${1:-}"
    printf '%s' "${PHASE_COLOR[$p]:-${C_GREY}}"
}

# ── Rendering ──────────────────────────────────────────────────────────────

render() {
    clear_screen

    TERM_ROWS=$(tput lines 2>/dev/null || echo 24)
    TERM_COLS=$(tput cols 2>/dev/null || echo 80)

    local row=1

    # ── Title bar ──
    goto "${row}" 1
    printf '%s' "${C_DIM}agent-dashboard${C_RESET} — cadence agents"
    local ts
    ts=$(date +%H:%M)
    local ts_col=$(( TERM_COLS - ${#ts} ))
    [[ "${ts_col}" -lt 2 ]] && ts_col=2
    goto "${row}" "${ts_col}"
    printf '%s' "${C_DIM}${ts}${C_RESET}"
    row=$((row + 2))

    local list_start=$row
    local statusbar_height=1
    local input_height=2
    local list_end=$(( TERM_ROWS - input_height - statusbar_height ))

    # ── Sections ──
    local visible_json
    visible_json=$(get_visible_all)

    local sec_order=("WAITING_FOR_INPUT" "WORKING" "COMPLETED")
    local sec_labels=("Waiting for Input" "Working" "Completed")
    local sec_icons=("◉" "●" "✓")
    local sec_colors=("${C_WAITING}" "${C_WORKING}" "${C_COMPLETED}")

    local global_idx=0

    for si in 0 1 2; do
        local sec_status="${sec_order[$si]}"
        local sec_label="${sec_labels[$si]}"
        local sec_icon="${sec_icons[$si]}"
        local sec_color="${sec_colors[$si]}"

        local sec_agents
        sec_agents=$(echo "${visible_json}" | jq --arg s "${sec_status}" \
            '[.[] | select(.status == $s)]' 2>/dev/null)
        local sec_count
        sec_count=$(echo "${sec_agents}" | jq 'length' 2>/dev/null || echo 0)

        [[ "${sec_count}" -eq 0 ]] && continue
        [[ $row -ge $list_end ]] && break

        # Section header.
        goto "${row}" 1
        printf '%s' "${C_BOLD}${sec_color}${sec_icon}  ${sec_label}${C_RESET}"
        printf '%s' "${C_DIM}  ${sec_count} agents${C_RESET}"
        printf '\033[K\n'
        row=$((row + 1))
        [[ $row -ge $list_end ]] && break

        # Group by project.
        local proj_slugs
        proj_slugs=$(echo "${sec_agents}" | jq -r '[.[].projectSlug] | unique | .[]' 2>/dev/null)
        local total_projects
        total_projects=$(echo "${sec_agents}" | jq -r '[.[].projectSlug] | unique | length' 2>/dev/null || echo 0)

        while IFS= read -r proj_slug; do
            [[ -z "${proj_slug}" ]] && continue
            [[ $row -ge $list_end ]] && break

            local proj_agents
            proj_agents=$(echo "${sec_agents}" | jq --arg p "${proj_slug}" \
                '[.[] | select(.projectSlug == $p)]' 2>/dev/null)
            local proj_count
            proj_count=$(echo "${proj_agents}" | jq 'length' 2>/dev/null || echo 0)
            [[ "${proj_count}" -eq 0 ]] && continue

            # Project header (only if multiple projects in section).
            if [[ "${total_projects}" -gt 1 ]]; then
                local proj_path
                proj_path=$(echo "${proj_agents}" | jq -r '.[0].projectPath // "~"' 2>/dev/null)
                goto "${row}" 1
                printf '%s' "${C_DIM}  ⎇ ${C_RESET}${proj_slug}${C_DIM}  ${proj_path}${C_RESET}"
                printf '\033[K\n'
                row=$((row + 1))
                [[ $row -ge $list_end ]] && break
            fi

            # Agent rows.
            local pai=0
            while [[ $pai -lt $proj_count ]]; do
                [[ $row -ge $list_end ]] && break

                local agent slug title phase runtime
                agent=$(echo "${proj_agents}" | jq ".[${pai}]" 2>/dev/null)
                slug=$(echo "${agent}" | jq -r '.taskSlug // ""' 2>/dev/null)
                title=$(echo "${agent}" | jq -r '.taskTitle // ""' 2>/dev/null)
                phase=$(echo "${agent}" | jq -r '.phase // ""' 2>/dev/null)
                runtime=$(echo "${agent}" | jq -r '.runtime // ""' 2>/dev/null)

                local is_sel=false
                [[ "${global_idx}" -eq "${SELECTED_INDEX}" ]] && is_sel=true

                goto "${row}" 1

                if ${is_sel}; then
                    printf '%s' "${C_BOLD}${C_MAGENTA}❯ ${C_BLUE}"
                    printf '%s' "$(pad "${slug}" 8)"
                    printf '%s' "${C_BRIGHT}"
                    printf ' %s' "${title}"
                    printf '%s' "${C_RESET}"
                else
                    printf '  '
                    printf '%s' "${C_BLUE}"
                    printf '%s' "$(pad "${slug}" 8)"
                    printf '%s' "${C_RESET}"
                    if [[ "${sec_status}" == "COMPLETED" ]]; then
                        printf '%s' "${C_DIM} %s${C_RESET}" "${title}"
                    else
                        printf ' %s' "${title}"
                    fi
                fi

                # Right-align runtime + phase.
                local pc
                pc=$(phase_color "${phase}")
                local right_str="${runtime}  ${pc}${phase}${C_RESET}"
                # Compute visible width of the row content so far.
                local left_len
                if ${is_sel}; then
                    left_len=$(( 2 + 8 + 1 + ${#title} ))
                else
                    left_len=$(( 2 + 8 + 1 + ${#title} ))
                fi
                local rt_plain="${runtime}  ${phase}"
                local padlen=$(( TERM_COLS - left_len - ${#rt_plain} ))
                [[ $padlen -lt 1 ]] && padlen=1
                printf '%*s' "${padlen}" ""
                printf '%s' "${C_DIM}${runtime}${C_RESET}  ${pc}${phase}${C_RESET}"
                printf '\033[K\n'

                row=$((row + 1))
                global_idx=$((global_idx + 1))
                pai=$((pai + 1))
            done
        done <<< "${proj_slugs}"
    done

    TOTAL_ROWS=$global_idx

    # Clamp selection.
    if [[ "${TOTAL_ROWS}" -gt 0 ]]; then
        if [[ "${SELECTED_INDEX}" -ge "${TOTAL_ROWS}" ]]; then
            SELECTED_INDEX=$(( TOTAL_ROWS - 1 ))
        fi
    else
        SELECTED_INDEX=0
    fi

    # ── Empty state ──
    if [[ "${TOTAL_ROWS}" -eq 0 ]]; then
        goto "$((list_start + 1))" 4
        printf '%s' "${C_DIM}No agents found.${C_RESET}"
        if [[ -n "${FILTER_TEXT}" ]]; then
            printf '  (filter: "%s")' "${FILTER_TEXT}"
        else
            printf '  Press %sn%s to create a new agent task.' "${C_BOLD}" "${C_RESET}"
        fi
        printf '\n'
    fi

    # ── Input line ──
    local input_row=$(( TERM_ROWS - 1 ))
    goto "${input_row}" 1
    printf '\033[K'

    if ${FILTER_ACTIVE}; then
        printf '%s' "${C_BOLD}${C_MAGENTA}/ ${FILTER_TEXT}${C_MAGENTA}█${C_RESET}"
    else
        printf '%s' "${C_DIM}${C_MAGENTA}❯ ${C_GREY}Describe a task for Claude to work on...${C_RESET}"
    fi

    # ── Status bar ──
    local bar_row=$(( TERM_ROWS ))
    goto "${bar_row}" 1
    printf '\033[K'
    printf '%s' "${C_DIM}"

    if [[ "${TOTAL_ROWS}" -gt 0 ]]; then
        printf '%d agents' "${TOTAL_ROWS}"
    else
        printf 'no agents'
    fi
    [[ -n "${FILTER_TEXT}" ]] && printf ' (filtered)'

    # Hints on the right.
    local hints
    if ${FILTER_ACTIVE}; then
        hints="type to filter  │  Enter apply  │  Esc clear"
    else
        hints="j/k nav  │  Enter attach  │  n new  │  s stop  │  m merge  │  r reject  │  / filter  │  q quit"
    fi
    local hint_col=$(( TERM_COLS - ${#hints} - 1 ))
    [[ "${hint_col}" -lt 10 ]] && hint_col=10
    goto "${bar_row}" "${hint_col}"
    printf '%s' "${hints}${C_RESET}"
    printf '\033[K'
}

# ── Actions ────────────────────────────────────────────────────────────────

do_attach() {
    local agent
    agent=$(get_visible_agent "${SELECTED_INDEX}")
    [[ -z "${agent}" || "${agent}" == "null" ]] && return

    local slug
    slug=$(echo "${agent}" | jq -r '.taskSlug // ""' 2>/dev/null)
    [[ -z "${slug}" ]] && return

    restore_terminal
    cadence agent attach "${slug}"
    setup_terminal
    NEEDS_REFRESH=true
}

do_new_agent() {
    local project_flag=""

    # Try to infer project from the currently selected agent.
    if [[ "${TOTAL_ROWS}" -gt 0 ]]; then
        local agent
        agent=$(get_visible_agent "${SELECTED_INDEX}")
        if [[ -n "${agent}" && "${agent}" != "null" ]]; then
            local proj
            proj=$(echo "${agent}" | jq -r '.projectSlug // ""' 2>/dev/null)
            [[ -n "${proj}" ]] && project_flag="--project ${proj}"
        fi
    fi

    # If no project context, let the user pick one.
    if [[ -z "${project_flag}" ]]; then
        restore_terminal
        echo "Select a project for the new agent (or Esc to cancel):"
        local proj
        proj=$(timeout 10 cadence project list 2>/dev/null | fzf --prompt="Project> " --height=15 2>/dev/null || true)
        if [[ -z "${proj}" ]]; then
            setup_terminal
            return
        fi
        # Extract slug — cadence project list typically shows "slug  name".
        local proj_slug
        proj_slug=$(echo "${proj}" | awk '{print $1}')
        [[ -n "${proj_slug}" ]] && project_flag="--project ${proj_slug}"
    else
        restore_terminal
    fi

    # shellcheck disable=SC2086
    cadence agent new ${project_flag}
    setup_terminal
    NEEDS_REFRESH=true
}

do_stop_agent() {
    local agent slug
    agent=$(get_visible_agent "${SELECTED_INDEX}")
    slug=$(echo "${agent}" | jq -r '.taskSlug // ""' 2>/dev/null)
    [[ -z "${slug}" ]] && return
    timeout 10 cadence agent stop "${slug}" 2>/dev/null || true
    NEEDS_REFRESH=true
}

do_merge_agent() {
    local agent slug status
    agent=$(get_visible_agent "${SELECTED_INDEX}")
    slug=$(echo "${agent}" | jq -r '.taskSlug // ""' 2>/dev/null)
    status=$(echo "${agent}" | jq -r '.status // ""' 2>/dev/null)
    [[ -z "${slug}" || "${status}" != "COMPLETED" ]] && return
    timeout 10 cadence agent merge "${slug}" 2>/dev/null || true
    NEEDS_REFRESH=true
}

do_reject_agent() {
    local agent slug status
    agent=$(get_visible_agent "${SELECTED_INDEX}")
    slug=$(echo "${agent}" | jq -r '.taskSlug // ""' 2>/dev/null)
    status=$(echo "${agent}" | jq -r '.status // ""' 2>/dev/null)
    [[ -z "${slug}" || "${status}" != "COMPLETED" ]] && return
    timeout 10 cadence agent reject "${slug}" 2>/dev/null || true
    NEEDS_REFRESH=true
}

# ── Filter input loop ──────────────────────────────────────────────────────

run_filter() {
    FILTER_ACTIVE=true
    FILTER_TEXT=""
    render

    local ir=$(( TERM_ROWS - 1 ))
    while true; do
        goto "${ir}" 1
        printf '\033[K'
        printf '%s' "${C_BOLD}${C_MAGENTA}/ ${FILTER_TEXT}${C_MAGENTA}█${C_RESET}"

        local ch=""
        IFS= read -rsn1 ch 2>/dev/null || continue

        case "${ch}" in
            $'\033')
                FILTER_ACTIVE=false
                FILTER_TEXT=""
                SELECTED_INDEX=0
                recount
                render
                return
                ;;
            $'\x7f'|$'\b')
                FILTER_TEXT="${FILTER_TEXT%?}"
                ;;
            ""|$'\n'|$'\r')
                FILTER_ACTIVE=false
                SELECTED_INDEX=0
                recount
                render
                return
                ;;
            $'\x03')  # Ctrl-C
                FILTER_ACTIVE=false
                FILTER_TEXT=""
                SELECTED_INDEX=0
                recount
                render
                return
                ;;
            *)
                FILTER_TEXT="${FILTER_TEXT}${ch}"
                ;;
        esac
        SELECTED_INDEX=0
        recount
        render
    done
}

# ── Main loop ──────────────────────────────────────────────────────────────

main() {
    setup_terminal

    load_data
    recount
    render

    while true; do
        local key=""
        IFS= read -rsn1 key 2>/dev/null || continue

        # Handle escape sequences.
        if [[ "${key}" == $'\033' ]]; then
            local seq=""
            IFS= read -rsn2 -t 0.005 seq 2>/dev/null || true
            key="${key}${seq}"
            case "${key}" in
                $'\033[A') key="UP" ;;
                $'\033[B') key="DOWN" ;;
                $'\033')   key="ESC" ;;
            esac
        fi

        # Refresh if needed.
        if ${NEEDS_REFRESH}; then
            load_data
            recount
            NEEDS_REFRESH=false
        fi

        case "${key}" in
            j|DOWN)
                if [[ "${TOTAL_ROWS}" -gt 0 ]]; then
                    SELECTED_INDEX=$(( (SELECTED_INDEX + 1) % TOTAL_ROWS ))
                fi
                render
                ;;
            k|UP)
                if [[ "${TOTAL_ROWS}" -gt 0 ]]; then
                    SELECTED_INDEX=$(( (SELECTED_INDEX - 1 + TOTAL_ROWS) % TOTAL_ROWS ))
                fi
                render
                ;;

            /)
                if ! ${FILTER_ACTIVE}; then
                    run_filter
                fi
                ;;

            ""|$'\n'|$'\r')
                if ${FILTER_ACTIVE}; then
                    FILTER_ACTIVE=false
                    SELECTED_INDEX=0
                    recount
                    render
                elif [[ "${TOTAL_ROWS}" -gt 0 ]]; then
                    do_attach
                    recount
                    render
                fi
                ;;
            n)
                if ! ${FILTER_ACTIVE}; then
                    do_new_agent
                    recount
                    render
                fi
                ;;
            s)
                if ! ${FILTER_ACTIVE} && [[ "${TOTAL_ROWS}" -gt 0 ]]; then
                    do_stop_agent
                    load_data
                    recount
                    SELECTED_INDEX=0
                    render
                fi
                ;;
            m)
                if ! ${FILTER_ACTIVE} && [[ "${TOTAL_ROWS}" -gt 0 ]]; then
                    do_merge_agent
                    load_data
                    recount
                    SELECTED_INDEX=0
                    render
                fi
                ;;
            r)
                if ! ${FILTER_ACTIVE} && [[ "${TOTAL_ROWS}" -gt 0 ]]; then
                    do_reject_agent
                    load_data
                    recount
                    SELECTED_INDEX=0
                    render
                fi
                ;;

            ESC|q)
                break
                ;;
            $'\x03'|$'\x04')  # Ctrl-C, Ctrl-D
                break
                ;;
            $'\x12')  # Ctrl-R refresh
                load_data
                recount
                if [[ "${TOTAL_ROWS}" -gt 0 && "${SELECTED_INDEX}" -ge "${TOTAL_ROWS}" ]]; then
                    SELECTED_INDEX=$(( TOTAL_ROWS - 1 ))
                fi
                render
                ;;
        esac
    done
}

main "$@"

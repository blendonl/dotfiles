#!/usr/bin/env bash
# ensure-macvlan — one-time setup for macvlan networking with rootful podman.
#
# Run once as root:
#   sudo ~/bin/ensure-macvlan
#
# This script:
#   1. Detects the primary LAN interface, subnet, and gateway.
#   2. Creates a rootful podman macvlan network for project containers.
#   3. Creates a host-side macvlan sub-interface so the host can reach
#      containers (and vice versa) without hairpin-NAT tricks.
#   4. Installs a systemd unit to recreate the host macvlan on boot.
#   5. Saves configuration to /etc/podman/ensure-compose.conf which
#      ensure-compose and project-picker read to switch into macvlan mode.
#
# After running this, follow the printed instructions to create the
# 'podman' group so your user can talk to the rootful podman socket.

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: This script must be run as root (use sudo)." >&2
    exit 1
fi

CONFIG_FILE="${ENSURE_COMPOSE_CONFIG:-/etc/podman/ensure-compose.conf}"

# ── Detect LAN ────────────────────────────────────────────────────────

PRIMARY_IFACE=$(ip -4 route show default 2>/dev/null | awk '{print $5; exit}')
if [[ -z "$PRIMARY_IFACE" ]]; then
    echo "ERROR: Could not detect primary network interface (no default route)." >&2
    exit 1
fi

PRIMARY_CIDR=$(ip -4 -o addr show "$PRIMARY_IFACE" 2>/dev/null \
    | awk '{print $4}' | grep -v '^127\.' | head -1)
if [[ -z "$PRIMARY_CIDR" ]]; then
    echo "ERROR: Could not detect IPv4 address on '${PRIMARY_IFACE}'." >&2
    exit 1
fi

IP_ADDR="${PRIMARY_CIDR%/*}"
PREFIX="${PRIMARY_CIDR#*/}"
GATEWAY=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')

IFS='.' read -r o1 o2 o3 o4 <<< "$IP_ADDR"

# Compute network address for any prefix length (bitwise AND with the mask).
if [[ "$PREFIX" -lt 1 || "$PREFIX" -gt 32 ]]; then
    echo "ERROR: Unsupported prefix /${PREFIX}." >&2
    exit 1
fi
_ip_num=$(( (o1 << 24) | (o2 << 16) | (o3 << 8) | o4 ))
_mask=$(( (0xFFFFFFFF << (32 - PREFIX)) & 0xFFFFFFFF ))
_net_num=$(( _ip_num & _mask ))
NETWORK="$(( (_net_num >> 24) & 255 )).$(( (_net_num >> 16) & 255 )).$(( (_net_num >> 8) & 255 )).$(( _net_num & 255 ))"

echo "→ LAN detected:"
echo "    interface : ${PRIMARY_IFACE}"
echo "    ip        : ${IP_ADDR}/${PREFIX}"
echo "    network   : ${NETWORK}/${PREFIX}"
echo "    gateway   : ${GATEWAY}"

# ── Configure IP pool ─────────────────────────────────────────────────
# Override-able via environment variables for unusual LAN layouts.

NETWORK_NAME="${MACVLAN_NETWORK_NAME:-projects-macvlan}"
POOL_START="${MACVLAN_POOL_START:-${o1}.${o2}.${o3}.200}"
POOL_END="${MACVLAN_POOL_END:-${o1}.${o2}.${o3}.239}"
HOST_MACVLAN_IP="${MACVLAN_HOST_IP:-${o1}.${o2}.${o3}.240}"
DNS_SERVER="${MACVLAN_DNS:-1.1.1.1}"

# ── Create rootful podman macvlan network ─────────────────────────────
# Unset both so podman talks to the system (rootful) socket instead of
# a user's rootless socket that sudo might have inherited.

unset DOCKER_HOST CONTAINER_HOST

echo "→ Creating rootful podman macvlan network '${NETWORK_NAME}' …"

if podman network ls --format '{{.Name}}' 2>/dev/null | grep -qxF "${NETWORK_NAME}"; then
    echo "   Network already exists — removing & recreating …"
    podman network rm -f "${NETWORK_NAME}" 2>/dev/null || true
fi

podman network create -d macvlan \
    --subnet "${NETWORK}/${PREFIX}" \
    --gateway "${GATEWAY}" \
    -o parent="${PRIMARY_IFACE}" \
    -o mode=bridge \
    "${NETWORK_NAME}"

echo "   ✓ macvlan network '${NETWORK_NAME}' created."

# ── Host-side macvlan sub-interface ───────────────────────────────────
# bridge-mode macvlan prevents the host from reaching its own children
# directly.  Create a sibling macvlan interface on the host itself so
# that host ↔ container traffic works (e.g. opening the browser at
# the container's LAN IP from the host).

HOST_IFACE="mac-host"

echo "→ Creating host macvlan interface '${HOST_IFACE}' (${HOST_MACVLAN_IP}/${PREFIX}) …"

# Tear down any stale instance first.
ip link del "${HOST_IFACE}" 2>/dev/null || true

ip link add "${HOST_IFACE}" link "${PRIMARY_IFACE}" type macvlan mode bridge
ip addr add "${HOST_MACVLAN_IP}/${PREFIX}" dev "${HOST_IFACE}"
ip link set "${HOST_IFACE}" up

echo "   ✓ host macvlan '${HOST_IFACE}' is up."

# ── Save config for ensure-compose / project-picker ───────────────────

mkdir -p "$(dirname "${CONFIG_FILE}")"

cat > "${CONFIG_FILE}" <<EOF
# ensure-compose macvlan configuration — auto-generated by ensure-macvlan
# $(date)
MACVLAN_NETWORK=${NETWORK_NAME}
MACVLAN_PARENT=${PRIMARY_IFACE}
MACVLAN_SUBNET=${NETWORK}/${PREFIX}
MACVLAN_GATEWAY=${GATEWAY}
MACVLAN_DNS=${DNS_SERVER}
MACVLAN_IP_POOL_START=${POOL_START}
MACVLAN_IP_POOL_END=${POOL_END}
MACVLAN_HOST_IP=${HOST_MACVLAN_IP}
PODMAN_SOCKET=unix:///run/podman/podman.sock
EOF

chmod 644 "${CONFIG_FILE}"
echo "   ✓ config saved to ${CONFIG_FILE}"

# ── Install systemd unit for host macvlan persistence ─────────────────

cat > /etc/systemd/system/ensure-macvlan.service <<EOF
[Unit]
Description=Host-side macvlan interface for podman project containers
Documentation=https://github.com/containers/podman
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ip link add ${HOST_IFACE} link ${PRIMARY_IFACE} type macvlan mode bridge
ExecStart=/usr/bin/ip addr add ${HOST_MACVLAN_IP}/${PREFIX} dev ${HOST_IFACE}
ExecStart=/usr/bin/ip link set ${HOST_IFACE} up
ExecStop=/usr/bin/ip link del ${HOST_IFACE} 2>/dev/null || true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable ensure-macvlan.service 2>/dev/null || true
systemctl start ensure-macvlan.service 2>/dev/null || true
echo "   ✓ systemd unit ensure-macvlan.service installed & started."

# ── Final instructions ────────────────────────────────────────────────

cat <<EOF


┌──────────────────────────────────────────────────────────────────────┐
│                      Setup complete!                                  │
├──────────────────────────────────────────────────────────────────────┤
│                                                                      │
│  Next steps (run these as root, then log out and back in):           │
│                                                                      │
│  1. Create a 'podman' group so your user can talk to the rootful     │
│     socket without sudo:                                             │
│                                                                      │
│       sudo groupadd -r podman                                        │
│       sudo usermod -aG podman notpc                                  │
│                                                                      │
│  2. Allow the podman group to access the system socket:              │
│                                                                      │
│       sudo mkdir -p /etc/systemd/system/podman.socket.d              │
│       printf '[Socket]\\nSocketMode=0660\\nSocketGroup=podman\\n' \\  │
│         | sudo tee /etc/systemd/system/podman.socket.d/override.conf │
│       sudo systemctl daemon-reload                                   │
│       sudo systemctl restart podman.socket                           │
│                                                                      │
│  3. Log out completely and back in (or reboot) so the group          │
│     membership and socket take effect.                               │
│                                                                      │
│  After that, ensure-compose automatically uses macvlan networking    │
│  and each project session gets its own IP on the LAN!               │
│                                                                      │
│  IP pool   : ${POOL_START} – ${POOL_END}                             │
│  Host link : ${HOST_MACVLAN_IP} (for host ↔ container traffic)       │
│                                                                      │
│  To revert:                                                          │
│    sudo systemctl disable --now ensure-macvlan.service               │
│    sudo rm /etc/podman/ensure-compose.conf                           │
│    podman network rm ${NETWORK_NAME}                                 │
│                                                                      │
└──────────────────────────────────────────────────────────────────────┘
EOF
